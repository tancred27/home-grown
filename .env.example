# Copy to .env and fill in what you need. Never commit .env (it is gitignored).
# Every setting is described in docs/configuration.md.

# Database (defaults match docker-compose.yml; development only)
HOMEGROWN_ADMIN_DSN=postgresql://homegrown:homegrown_dev_only@localhost:5433/homegrown
HOMEGROWN_APP_DSN=postgresql://homegrown_app:homegrown_app_dev_only@localhost:5433/homegrown

# GitHub: path to a file holding a read-only token
HOMEGROWN_GITHUB_TOKEN_FILE=

# Language model. Without one, HomeGrown runs in rules mode.
# Providers: anthropic | groq | gemini | local | disabled
HOMEGROWN_LLM_PROVIDER=disabled
HOMEGROWN_VERDICT_MODE=rules
# HOMEGROWN_LLM_MODEL=
# Keys: point to a file here, or export ANTHROPIC_API_KEY / GROQ_API_KEY / GEMINI_API_KEY
# in your shell (keys without the HOMEGROWN_ prefix are NOT read from this file).
# HOMEGROWN_GROQ_KEY_FILE=/path/to/groq-key.txt
# HOMEGROWN_GEMINI_KEY_FILE=/path/to/gemini-key.txt
# HOMEGROWN_LLM_BASE_URL=http://localhost:11434/v1   for provider "local" (e.g. Ollama)

# Who is asking (CLI and MCP server). Create with: homegrown add-user <login>
# HOMEGROWN_USER=

# Webhooks (optional). Empty secrets reject every delivery.
# HOMEGROWN_GITHUB_WEBHOOK_SECRET=
# HOMEGROWN_DOCS_WEBHOOK_SECRET=
